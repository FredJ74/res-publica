{
  "functions": {
    "api/chat.js": {
      "maxDuration": 30
    },
    "api/assemblee-seblex.js": {
      "maxDuration": 30
    },
    "api/cron-minuit.js": {
      "maxDuration": 120
    },
    "api/cron-assemblee.js": {
      "maxDuration": 60
    },
    "api/upload-org-avatar.js": {
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/cron-minuit",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron-assemblee",
      "schedule": "0 21 * * 3"
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
