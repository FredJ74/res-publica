{
  "ignoreCommand": "node vercel-ignore-build.cjs",
  "functions": {
    "api/chat.js": {
      "maxDuration": 30
    },
    "api/assemblee-seblex.js": {
      "maxDuration": 30
    },
    "api/cron-minuit.js": {
      "maxDuration": 120
    },
    "api/cron-assemblee.js": {
      "maxDuration": 60
    },
    "api/upload-org-avatar.js": {
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/cron-minuit",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/cron-assemblee",
      "schedule": "0 22 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/images/arme-fusil-republic.png",
      "destination": "/images/arme-fusil-republic.webp"
    },
    {
      "source": "/images/arme-mitraillette-militaire.png",
      "destination": "/images/arme-mitraillette-militaire.webp"
    },
